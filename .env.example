# Copy this file to .env and fill in real local values before running
# scripts\setup-windows.ps1. Never commit the real .env file.
#
# The default, required evaluator path is native Windows + Node.js + SQLite
# (no Docker, no PostgreSQL). Docker/PostgreSQL remain available as an
# optional production-like path -- see scripts/docker-optional/.

# --- App server ---
PORT=3000
NODE_ENV=production
# Generate a random 32+ character string for local sessions, e.g.:
#   powershell -c "[Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))"
SESSION_SECRET=replace-with-a-random-local-secret
# Only set to "true" when actually served over HTTPS behind a TLS-terminating
# proxy. Left false (the default) for plain http://localhost, which is the
# normal native deployment -- a "secure" cookie is silently dropped over
# plain HTTP, which would otherwise break sign-in.
COOKIE_SECURE=false

# --- Local test administrator (single pre-authorized operator, seeded by scripts/setup-windows.ps1) ---
ADMIN_EMAIL=darren@example.com
ADMIN_PASSWORD=change-this-local-test-password

# --- Persistence: SQLite is the default and requires no further configuration. ---
# DB_DRIVER=sqlite
# Uncomment and set these only to override the default locations
# (data/app.db and data/files under the app root):
# DATA_DIR=./data
# SQLITE_PATH=./data/app.db
# UPLOAD_DIR=./data/files

# --- Optional Miva JSON API integration (Phase 2) ---
# Leave all of these unset to keep the app in CSV-only mode (the default).
# Set them to enable "Pull from Miva API" as a source for a run's Miva snapshot.
# MIVA_STORE_URL=https://your-store-domain.com
# MIVA_STORE_CODE=YOUR_STORE_CODE
# MIVA_API_TOKEN=your-api-token-access-id
# MIVA_API_SIGNING_KEY=your-base64-signing-key
# Only needed if the target store is additionally behind .htaccess HTTP Basic Auth
# (true for CozyWinters' current Miva development store):
# MIVA_HTTP_BASIC_USER=
# MIVA_HTTP_BASIC_PASSWORD=

# --- Optional PostgreSQL/Docker path (see scripts/docker-optional/) ---
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://cozywinters:changeme-local-dev-only@postgres:5432/cozywinters_olliix
# POSTGRES_USER=cozywinters
# POSTGRES_PASSWORD=changeme-local-dev-only
# POSTGRES_DB=cozywinters_olliix
# HOST_APP_PORT=3000
# HOST_POSTGRES_PORT=5432
